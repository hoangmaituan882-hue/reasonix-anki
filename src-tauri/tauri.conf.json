{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reasonix Anki",
  "version": "0.1.0",
  "identifier": "com.linze.reasonix-anki",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run addon:sync && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reasonix Anki",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "基于 AnkiConnect 的 Anki 学习工作台",
    "longDescription": "Reasonix Anki：牌组浏览、笔记编辑、自建复习流与统计概览，通过 AnkiConnect 与本地 Anki 通信。",
    "resources": {
      "resources/reasonix-anki-addon.ankiaddon": "reasonix-anki-addon.ankiaddon"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
